{
  "about": "Tracker list for consent-tracker-scan. Each entry maps request host names (the domain and all its subdomains), cookie names and web storage keys (shell-style wildcards, case-sensitive) to a vendor and category. 'source' is the vendor documentation that describes the domains or cookies. Compiled by hand from those pages; vendors change them, so treat this as a starting point and send corrections.",
  "categories": {
    "analytics": "Measures visits and behaviour; usually sets identifiers.",
    "advertising": "Ad serving, conversion tracking and retargeting.",
    "social_pixel": "Social network pixels and plugins that report visits back to the network.",
    "session_replay": "Records clicks, scrolls and page changes to replay sessions.",
    "tag_manager": "Loads other tags; not a tracker by itself but usually the first to fire.",
    "embed": "Embedded third-party content (video players) that can set cookies.",
    "cdn_fonts": "Public CDNs and web fonts; the visitor's IP address reaches the provider (low).",
    "consent": "Consent management platforms (the cookie banner itself)."
  },
